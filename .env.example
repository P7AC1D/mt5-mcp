# Use an explicit --env-file path for supervised deployment. Never commit secrets.
# Without credentials, initialize uses the terminal's saved current account.
# MT5_LOGIN=12345678
# MT5_PASSWORD=replace_locally
# MT5_SERVER=MetaQuotes-Demo
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Strongly recommended: reject the wrong account/broker at startup.
# MT5_EXPECTED_LOGIN=12345678
# MT5_EXPECTED_SERVER=MetaQuotes-Demo
MT5_ALLOW_ACCOUNT_SWITCH=false

# Bounded native owner, deadlines, result limits.
MT5_QUEUE_SIZE=64
MT5_REQUEST_TIMEOUT=60
MT5_SHUTDOWN_TIMEOUT=65
MT5_INITIALIZE_TIMEOUT_MS=30000
MT5_MAX_ROWS=100000
MT5_MAX_RANGE_DAYS=366

# Modern endpoint /mcp. Enable only while existing clients require /sse.
MT5_LEGACY_SSE=false
MT5_LEGACY_SSE_MAX_SECONDS=300
MT5_MAX_SESSIONS=128
MT5_SESSION_IDLE_TIMEOUT=300
MT5_MAX_REQUEST_BYTES=1048576

# Local loopback is the HTTP default. Protect remote traffic with TLS and auth.
# Do not put tokens in command-line arguments, Git, or client debug logs.
# MT5_HTTP_TOKEN=replace_with_existing_securely_provisioned_secret
MT5_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
MT5_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]

# Windows launcher sets absolute shared paths across releases. These defaults
# are relative to the working directory. Never run two owners for one terminal.
MT5_LOCK_FILE=.runtime/mt5.lock
MT5_JOURNAL_FILE=.runtime/operations.jsonl
# MT5_LOG_FILE=.runtime/server.log
